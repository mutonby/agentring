{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.mutonby/agentring",
  "title": "agentring",
  "description": "Let your AI agent message and call your Android phone, and get your reply or the call transcript.",
  "version": "0.2.0",
  "websiteUrl": "https://agentring.io",
  "repository": {
    "url": "https://github.com/mutonby/agentring",
    "source": "github",
    "subfolder": "daemon"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://agentring.io/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Your agentring API key, from the dashboard at https://agentring.io after you pair your phone.",
          "value": "Bearer {api_key}",
          "isRequired": true,
          "isSecret": true,
          "variables": {
            "api_key": {
              "description": "agentring API key (starts with ak_)",
              "placeholder": "ak_...",
              "isRequired": true,
              "isSecret": true
            }
          }
        }
      ]
    }
  ]
}
