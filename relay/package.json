{
  "name": "@agentring/relay",
  "version": "0.2.0",
  "description": "agentring relay: pairing, events, push and call signalling",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/vendor-web.mjs",
    "start": "node --disable-warning=ExperimentalWarning dist/main.js",
    "dev": "node scripts/vendor-web.mjs && tsx watch src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "gen:types": "openapi-typescript ../protocol/relay.openapi.yaml -o src/generated/api.ts"
  },
  "dependencies": {
    "@fastify/websocket": "^11.3.4",
    "fastify": "^5.12.7",
    "jose": "^6.2.13",
    "livekit-server-sdk": "2.19.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "livekit-client": "2.22.4",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "ws": "^8.22.0"
  }
}
